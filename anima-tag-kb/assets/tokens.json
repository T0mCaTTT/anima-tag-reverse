{
  "$description": "Anima 标签工作台 · 设计令牌（与 anima-tag-kb/viewer/template.html 的 CSS 变量一一对应）。导入方式：Figma → Tokens Studio 插件 → Import → 选择本文件；动效曲线可直接读到 Figma 的 Smart Animate / 变量里。",
  "core": {
    "radius": {
      "r1-small":     { "value": "10px", "type": "borderRadius", "description": "小元件 / 角标按钮（--r1）" },
      "r2-control":   { "value": "12px", "type": "borderRadius", "description": "按钮、输入框、下拉（--r2）" },
      "r3-mid":       { "value": "14px", "type": "borderRadius", "description": "次级面板 / 内层卡片（--r3）" },
      "r4-panel":     { "value": "16px", "type": "borderRadius", "description": "面板、抽屉内块（--r4）" },
      "r5-card":      { "value": "18px", "type": "borderRadius", "description": "标签卡、页头、托盘、悬浮窗（--r5 / --r）" },
      "pill":         { "value": "999px", "type": "borderRadius", "description": "胶囊：分类条、小分类条、已选 chip、徽章（--pill）" }
    },
    "motion": {
      "duration-micro":  { "value": "150ms", "type": "duration", "description": "微交互：hover / 按下（--dur-1）" },
      "duration-panel":  { "value": "260ms", "type": "duration", "description": "面板、抽屉、悬浮窗（--dur-2）" },
      "duration-theme":  { "value": "420ms", "type": "duration", "description": "主题切换圆形扩散（--dur-3）" },
      "ease-standard":   { "value": "cubic-bezier(0.4, 0, 0.2, 1)",  "type": "cubicBezier", "description": "标准缓动（--ease）" },
      "ease-out-soft":   { "value": "cubic-bezier(0.22, 0.8, 0.28, 1)", "type": "cubicBezier", "description": "柔和出场（--ease-out）" },
      "ease-spring":     { "value": "cubic-bezier(0.34, 1.4, 0.64, 1)", "type": "cubicBezier", "description": "回弹（--ease-spring，月亮进场 / 卡片点选）" }
    },
    "glass": {
      "blur-dark":  { "value": "blur(22px) saturate(1.7)", "type": "other", "description": "--glass-blur（深色）" },
      "blur-light": { "value": "blur(22px) saturate(1.7)", "type": "other", "description": "--glass-blur（日间同配方）" },
      "inner-highlight": { "value": "inset 0 1px 0 rgba(255,255,255,0.07)", "type": "boxShadow", "description": "玻璃内高光（--glass-in 深色）" }
    },
    "layout": {
      "card-min-desktop": { "value": "220px", "type": "sizing", "description": "桌面卡片最小宽（1180 断点）" },
      "card-min-narrow":  { "value": "168px", "type": "sizing", "description": "窄屏卡片最小宽（760 断点）" },
      "thumb":            { "value": "112px × 72px", "type": "sizing", "description": "卡片右上角缩略图" },
      "thumb-mobile":     { "value": "76px × 52px", "type": "sizing", "description": "520 断点缩略图" },
      "drawer-max":       { "value": "min(430px, 86vw)", "type": "sizing", "description": "装配台抽屉宽（1180 断点）" }
    },
    "breakpoints": {
      "bp-1180": { "value": "1180px", "type": "other", "description": "网格收窄、抽屉限宽" },
      "bp-980":  { "value": "980px",  "type": "other", "description": "隐藏统计行" },
      "bp-820":  { "value": "820px",  "type": "other", "description": "隐藏悬浮窗、加托盘下边距" },
      "bp-760":  { "value": "760px",  "type": "other", "description": "搜索框变宽、托盘紧凑、抽屉全宽" },
      "bp-520":  { "value": "520px",  "type": "other", "description": "单列网格、缩略图缩小、小分类标签隐藏" }
    }
  },
